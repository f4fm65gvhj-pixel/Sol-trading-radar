import json
import urllib.request
from datetime import datetime, timezone

BASE_URL = "https://api.binance.com"
SIMBOLOS = ["SOLUSDT", "LINKUSDT", "AVAXUSDT"]

print("=== SOL TRADING RADAR - PRUEBA BINANCE ===")
print("Hora UTC:", datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S"))

for simbolo in SIMBOLOS:
    url = f"{BASE_URL}/api/v3/ticker/price?symbol={simbolo}"

    try:
        with urllib.request.urlopen(url, timeout=10) as respuesta:
            datos = json.loads(respuesta.read().decode("utf-8"))

        print(f"{simbolo}: {datos['price']} USDT")

    except Exception as error:
        print(f"{simbolo}: ERROR -> {error}")

print("=== FIN DE PRUEBA ===")
